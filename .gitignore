# The Python environments. requirements.txt and requirements_triceratops.txt list their packages.
.venv/
.venv_triceratops/

# Downloads. The README gives the commands that download them again.
data/

# TRICERATOPS writes its Gaia background star list to the working directory. Step 10 moves it to data/, but a
# stop before the move leaves it here.
*_gaia_background.csv

# Step 4 writes vetting.csv while it runs, and replaces it with vetting.csv.gz when it finishes. A stopped run
# leaves vetting.csv, which the next run continues.
results/qlp_sector_*_leo_vetting/vetting.csv

# The live progress of the running steps, for the candidate board.
results/pipeline_status/

__pycache__/
.DS_Store
